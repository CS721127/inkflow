{
  "name": "inkflow",
  "version": "1.4.0",
  "private": true,
  "description": "Local-first Markdown editor with math, multi-document workspaces, on-device grammar checking and styled A4 PDF exports",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "dev": "node scripts/serve.mjs",
    "setup:harper": "node scripts/vendor-harper.mjs",
    "postinstall": "node scripts/vendor-harper.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build-site.mjs",
    "package:offline": "python3 scripts/pack_offline.py"
  },
  "dependencies": {
    "harper.js": "2.4.0"
  },
  "engines": {
    "node": ">=18"
  }
}
