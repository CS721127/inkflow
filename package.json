{
  "name": "interactive-writer-pro",
  "version": "1.1.0",
  "private": true,
  "description": "Offline-first Markdown writer with MathJax equations, local multi-file workspaces, Harper grammar, stationery PDF",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "dev": "node scripts/serve.mjs",
    "setup:harper": "node scripts/vendor-harper.mjs",
    "postinstall": "node scripts/vendor-harper.mjs",
    "test": "node --test tests/*.test.mjs",
    "package:offline": "python3 scripts/pack_offline.py"
  },
  "dependencies": {
    "harper.js": "2.4.0"
  },
  "engines": {
    "node": ">=18"
  }
}
